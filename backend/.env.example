NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cloudi-sync
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=cloudi-sync-backend
JWT_AUDIENCE=cloudi-sync-frontend
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=12
TRUST_PROXY_ENABLED=false
ENFORCE_HTTPS_IN_PROD=false
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
TRADING_ENGINE_ENABLED=false
TRADING_ENGINE_BASE_URL=http://127.0.0.1:8000
TRADING_ENGINE_TIMEOUT_MS=5000
TRADING_ENGINE_API_KEY=